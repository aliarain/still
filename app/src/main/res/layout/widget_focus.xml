<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus widget: today's screen time, the live focus window, and the two
  tightest app budgets. Deliberately text-only to match Still's home screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/widget_screen_time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.08"
        android:text="@string/widget_screen_time_label"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_screen_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_no_data"
        android:textColor="#FFFFFFFF"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_focus_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text=""
        android:textColor="#B3FFFFFF"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_limit_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#DDFFFFFF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_limit_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text=""
        android:textColor="#DDFFFFFF"
        android:textSize="13sp" />

</LinearLayout>
